BASE_URL=http://localhost:3000
E2E_USER=username@example.com:password
HEALTH_CHECK_CONCURRENCY=1
HEALTH_CHECK_HEADLESS=true
HEALTH_CHECK_SLOW_MO_MS=0
TARGET_CODEBASE_PATH=../fe-app
AUTO_REMEDIATION_ENABLED=false
ZIPPY_COMMAND=
ZIPPY_MR_COMMAND=
AUTH_MODE=ui-login
AUTH_TTL_MINUTES=60
AUTH_SUCCESS_SELECTOR=[class^="Navbar"]
INTERACTIVE_AUTH_TIMEOUT_MS=180000
HEALTH_CHECK_TIMEOUT_MS=30000
HEALTH_CHECK_POST_LOAD_WAIT_MS=3000
IGNORE_CONSOLE_ERRORS=Failed to load resource|Failed to load resource: the server responded with a status of 404 (Not Found)
ERROR_BOUNDARY_SELECTORS=[data-testid="error-boundary"]
ERROR_BOUNDARY_TEXTS=Service Unavailable|Something went wrong|Application error|TID:
